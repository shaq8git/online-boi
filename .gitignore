  # Root ignores
  .DS_Store
  Thumbs.db

  # Environment files
  .env
  .env.*
  !.env.example

  # Python backend
  backend/venv/
  backend/__pycache__/
  backend/**/*.pyc
  backend/.pytest_cache/
  backend/.mypy_cache/

  # Node frontend
  frontend/node_modules/
  frontend/dist/
  frontend/.vite/

  # Editor files
  .vscode/
  .idea/

  # Logs
  *.log
  npm-debug.log*
  yarn-debug.log*
  yarn-error.log*

  # Build / cache
  coverage/
  .pytest_cache/